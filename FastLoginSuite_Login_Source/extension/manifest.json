{
  "manifest_version": 3,
  "name": "HOF FastLogin Extension",
  "version": "1.0.0",
  "key": "",
  "description": "Automated Native Login and Token Sync Extension for FastLogin Suite",
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "browsingData"
  ],
  "host_permissions": [
    "https://passport.thehof.gg/*",
    "https://member.thehof.gg/*",
    "https://core-api.thehof.gg/*",
    "https://challenges.cloudflare.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_icon": "icon.png",
    "default_title": "HOF FastLogin Extension"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://passport.thehof.gg/*",
        "https://member.thehof.gg/*",
        "https://challenges.cloudflare.com/*"
      ],
      "all_frames": true,
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
